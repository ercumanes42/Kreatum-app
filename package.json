{
    "name":  "kreatum-platform",
    "private":  true,
    "version":  "2.0.0",
    "type":  "module",
    "scripts":  {
                    "dev":  "vite --configLoader runner --port=3000 --host=127.0.0.1",
                    "dev:lan":  "vite --configLoader runner --port=3000 --host=0.0.0.0",
                    "build":  "vite build --configLoader runner",
                    "build:functions":  "npm --prefix functions run build",
                    "preview":  "vite preview",
                    "clean":  "node scripts/clean.mjs",
                    "typecheck":  "tsc --noEmit",
                    "typecheck:functions":  "npm --prefix functions run typecheck",
                    "lint":  "eslint . --max-warnings=0",
                    "test":  "npm run test:unit \u0026\u0026 npm run test:rules",
                    "test:unit":  "tsx --test shared/*.test.ts src/lib/*.test.ts \u0026\u0026 node --test scripts/production-smoke-safety.test.mjs scripts/release-security.test.mjs scripts/security-alert-policies.test.mjs scripts/function-test-suites.test.mjs scripts/staging-security-smoke.test.mjs scripts/staging-browser-transport.test.mjs",
                    "test:unit:functions":  "npm --prefix functions test",
                    "test:contracts":  "tsx --test shared/contracts.test.ts",
                    "test:rules":  "firebase emulators:exec --only firestore,storage --project demo-kreatum \"tsx --test tests/firestore.rules.test.ts tests/storage.rules.test.ts\"",
                    "test:integration":  "node scripts/run-functions-integration.mjs",
                    "test:functions":  "npm run test:integration",
                    "test:e2e":  "playwright test e2e/accessibility.spec.ts",
                    "test:e2e:access":  "node scripts/run-access-e2e.mjs",
                    "test:e2e:report":  "node scripts/run-report-e2e.mjs",
                    "test:report":  "npm run test:integration",
                    "verify":  "npm run lint \u0026\u0026 npm run typecheck \u0026\u0026 npm run typecheck:functions \u0026\u0026 npm run test:unit \u0026\u0026 npm run test:unit:functions \u0026\u0026 npm run test:rules \u0026\u0026 npm run build \u0026\u0026 npm run build:functions",
                    "verify:release":  "node scripts/verify-release.mjs --full",
                    "audit:security":  "node scripts/audit-security.mjs",
                    "test:load":  "firebase emulators:exec --only firestore --project demo-kreatum \"npm --prefix functions run test:load:worker\"",
                    "test:migration":  "firebase emulators:exec --only auth,firestore --project demo-kreatum \"npm --prefix functions run test:migration:worker\""
                },
    "dependencies":  {
                         "@tailwindcss/vite":  "^4.1.14",
                         "@vitejs/plugin-react":  "^5.0.4",
                         "clsx":  "^2.1.1",
                         "firebase":  "^12.12.1",
                         "lucide-react":  "^0.546.0",
                         "motion":  "^12.23.24",
                         "react":  "^19.0.0",
                         "react-dom":  "^19.0.0",
                         "tailwind-merge":  "^3.5.0",
                         "vite":  "^6.2.0"
                     },
    "devDependencies":  {
                            "@axe-core/playwright":  "4.12.1",
                            "@eslint/js":  "10.0.1",
                            "@firebase/rules-unit-testing":  "5.0.1",
                            "@playwright/test":  "1.62.1",
                            "@types/node":  "^22.14.0",
                            "@types/react":  "^19.0.0",
                            "@types/react-dom":  "^19.0.0",
                            "autoprefixer":  "^10.4.21",
                            "eslint":  "10.8.0",
                            "eslint-plugin-react-hooks":  "7.1.1",
                            "eslint-plugin-react-refresh":  "0.5.3",
                            "tailwindcss":  "^4.1.14",
                            "tsx":  "^4.21.0",
                            "typescript":  "~5.8.2",
                            "typescript-eslint":  "8.65.0",
                            "vite":  "^6.2.0"
                        },
    "overrides":  {
                      "@grpc/grpc-js":  "1.13.7"
                  }
}
