# Firebase web configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_APP_ID=1:829452780690:web:20d259ebf5defe2286124b
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app

# KREATUM v2
VITE_KREATUM_DATA_MODEL=v2
VITE_DEFAULT_ORGANIZATION_ID=your_organization_id
VITE_FIREBASE_FUNCTIONS_REGION=europe-west1

# Local emulators
VITE_FIREBASE_USE_EMULATORS=false

# Optional App Check rollout
VITE_FIREBASE_APPCHECK_SITE_KEY=
# Required before enabling invitation activation
VITE_PRIVACY_POLICY_URL=https://www.example.com/privacy
VITE_TERMS_URL=https://www.example.com/terms
