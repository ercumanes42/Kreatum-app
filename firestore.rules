rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validRole(role) {
      return role in ['owner', 'facilitator'];
    }

    function organization(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId));
    }

    function hasVersionedCommercialAccess(orgId) {
      let record = organization(orgId).data;
      return record.keys().hasAll(['status', 'schemaVersion', 'commercial'])
        && record.status == 'active'
        && record.schemaVersion is int
        && record.schemaVersion >= 2
        && record.commercial is map
        && record.commercial.keys().hasAll(['status', 'validFrom', 'validUntil'])
        && record.commercial.status in ['trial', 'active']
        && record.commercial.validFrom is timestamp
        && record.commercial.validFrom <= request.time
        && (
          record.commercial.validUntil == null
          || (
            record.commercial.validUntil is timestamp
            && record.commercial.validUntil > request.time
          )
        );
    }

    function isOrganizationOperational(orgId) {
      return exists(/databases/$(database)/documents/organizations/$(orgId))
        && hasVersionedCommercialAccess(orgId);
    }

    function membership(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function isOrganizationMember(orgId) {
      return signedIn()
        && isOrganizationOperational(orgId)
        && exists(
          /databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)
        )
        && membership(orgId).data.status == 'active'
        && validRole(membership(orgId).data.role);
    }

    function hasOrganizationRole(orgId, roles) {
      return isOrganizationMember(orgId)
        && membership(orgId).data.role in roles;
    }

    function workshop(workshopId) {
      return get(/databases/$(database)/documents/workshops/$(workshopId));
    }

    function workshopOrganizationId(workshopId) {
      return workshop(workshopId).data.organizationId;
    }

    function hasCanonicalFacilitator(workshopData) {
      return workshopData.keys().hasAll(['facilitatorUid'])
        && workshopData.facilitatorUid is string
        && workshopData.facilitatorUid.size() >= 3
        && workshopData.facilitatorUid.size() <= 128;
    }

    function isExplicitLegacyWorkshop(workshopData) {
      return workshopData.keys().hasAll(['schemaVersion', 'migration'])
        && workshopData.schemaVersion == 2
        && workshopData.migration is map
        && workshopData.migration.keys().hasAll(['sourceCollection'])
        && workshopData.migration.sourceCollection == 'games';
    }

    function hasRecognizedWorkshopAssignment(workshopData) {
      return hasCanonicalFacilitator(workshopData)
        || isExplicitLegacyWorkshop(workshopData);
    }

    function canManageWorkshopData(workshopData) {
      return signedIn()
        && workshopData.keys().hasAll(['organizationId'])
        && workshopData.organizationId is string
        && isOrganizationOperational(workshopData.organizationId)
        && (
          hasOrganizationRole(workshopData.organizationId, ['owner'])
          || (
            hasCanonicalFacilitator(workshopData)
            && workshopData.facilitatorUid == request.auth.uid
            && hasOrganizationRole(workshopData.organizationId, ['facilitator'])
          )
        );
    }
    function canListWorkshopData(workshopData) {
      return signedIn()
        && workshopData.keys().hasAll(['organizationId'])
        && workshopData.organizationId is string
        && isOrganizationOperational(workshopData.organizationId)
        && (
          hasOrganizationRole(workshopData.organizationId, ['owner'])
          || (
            hasCanonicalFacilitator(workshopData)
            && workshopData.facilitatorUid == request.auth.uid
            && hasOrganizationRole(workshopData.organizationId, ['facilitator'])
          )
        );
    }



    function isWorkshopAdmin(workshopId) {
      return canManageWorkshopData(workshop(workshopId).data);
    }

    function isVerifiedGfsIdentity() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[^@]+@[gG][fF][sS][.][eE][sS]$');
    }

    function canReadWorkshopReports(workshopId) {
      let workshopData = workshop(workshopId).data;
      return signedIn()
        && workshopData.keys().hasAll(['organizationId'])
        && workshopData.organizationId is string
        && isOrganizationOperational(workshopData.organizationId)
        && (
          hasOrganizationRole(workshopData.organizationId, ['owner'])
          || (
            isVerifiedGfsIdentity()
            && hasCanonicalFacilitator(workshopData)
            && workshopData.facilitatorUid == request.auth.uid
            && hasOrganizationRole(workshopData.organizationId, ['facilitator'])
          )
        );
    }

    function participantSession(workshopId) {
      return get(
        /databases/$(database)/documents/workshops/$(workshopId)/participantSessions/$(request.auth.uid)
      );
    }

    function isWorkshopParticipant(workshopId) {
      let session = participantSession(workshopId).data;
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && isActiveWorkshop(workshopId)
        && exists(
          /databases/$(database)/documents/workshops/$(workshopId)/participantSessions/$(request.auth.uid)
        )
        && session.status == 'active'
        && session.expiresAt > request.time
        && ownsDeviceSlot(workshopId, session.deviceSlot);
    }

    function ownsDeviceSlot(workshopId, slot) {
      let reservation = get(/databases/$(database)/documents/workshops/$(workshopId)/participantDeviceSlots/$(string(slot)));
      return slot is int && slot >= 0 && slot < 4
        && reservation.data.participantId == request.auth.uid
        && reservation.data.expiresAt > request.time;
    }

    function isAssignedParticipant(workshopId) {
      let team = participantTeam(workshopId);
      return isWorkshopParticipant(workshopId)
        && validTeam(team)
        && ownsTeamReservation(workshopId, team);
    }

    function isTerminalWorkshopParticipant(workshopId) {
      let workshopData = workshop(workshopId).data;
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && workshopData.status in ['completed', 'archived']
        && workshopData.keys().hasAll(['organizationId'])
        && workshopData.organizationId is string
        && hasRecognizedWorkshopAssignment(workshopData)
        && isOrganizationOperational(workshopData.organizationId)
        && exists(
          /databases/$(database)/documents/workshops/$(workshopId)/participantSessions/$(request.auth.uid)
        )
        && participantSession(workshopId).data.status in ['active', 'expired'];
    }

    function participantTeam(workshopId) {
      return participantSession(workshopId).data.team;
    }

    function ownsTeamReservation(workshopId, team) {
      let reservation = get(
        /databases/$(database)/documents/workshops/$(workshopId)/teams/$(team)
      );
      return reservation.data.keys().hasAll([
          'activeParticipantId',
          'activeDeviceExpiresAt'
        ])
        && reservation.data.activeParticipantId == request.auth.uid
        && reservation.data.activeDeviceExpiresAt > request.time;
    }

    function hasAcknowledgedPendingTransition(workshopId) {
      let workshopData = workshop(workshopId).data;
      let session = participantSession(workshopId).data;
      return workshopData.keys().hasAny(['pendingTransitionId'])
        && session.keys().hasAny(['transitionAckId'])
        && session.get('transitionAckId', null) == workshopData.get('pendingTransitionId', null);
    }

    function isActiveWorkshop(workshopId) {
      let workshopData = workshop(workshopId).data;
      return workshopData.status == 'active'
        && workshopData.keys().hasAll(['organizationId'])
        && workshopData.organizationId is string
        && hasRecognizedWorkshopAssignment(workshopData)
        && isOrganizationOperational(workshopData.organizationId);
    }

    function isWorkshopPhase(workshopId, phase) {
      return workshop(workshopId).data.currentPhase == phase;
    }

    function validTeam(team) {
      return team in ['Fuego', 'Agua', 'Aire', 'Tierra'];
    }

    function validText(value) {
      return value is string && value.size() <= 20000;
    }

    function validOptionalText(field) {
      let value = request.resource.data.get(field, '');
      return value is string && value.size() <= 20000;
    }

    function validOptionalBool(field) {
      return request.resource.data.get(field, false) is bool;
    }
    function validOptionalList(field, maxItems) {
      let value = request.resource.data.get(field, []);
      return value is list && value.size() <= maxItems;
    }

    function validTeamContentShape() {
      // Same complete shape; inline checks keep evaluation within the Rules expression budget.
      let data = request.resource.data;
      return (data.get('perspectives', []) is list && data.get('perspectives', []).size() <= 50)
        && (data.get('top3Perspectives', []) is list && data.get('top3Perspectives', []).size() <= 3)
        && (data.get('perspectiveVotes', []) is list && data.get('perspectiveVotes', []).size() <= 3)
        && (data.get('selectedPerspective', '') is string && data.get('selectedPerspective', '').size() <= 20000)
        && (data.get('solutions', []) is list && data.get('solutions', []).size() <= 50)
        && (data.get('top3Solutions', []) is list && data.get('top3Solutions', []).size() <= 3)
        && (data.get('solutionVotes', []) is list && data.get('solutionVotes', []).size() <= 3)
        && (data.get('selectedSolution', '') is string && data.get('selectedSolution', '').size() <= 20000)
        && (data.get('receivedSolutionToAttack', '') is string && data.get('receivedSolutionToAttack', '').size() <= 20000)
        && (data.get('attacksOnOthers', []) is list && data.get('attacksOnOthers', []).size() <= 20)
        && (data.get('receivedAttacks', []) is list && data.get('receivedAttacks', []).size() <= 20)
        && (data.get('defenses', []) is list && data.get('defenses', []).size() <= 20)
        && (data.get('reformulatedSolution', '') is string && data.get('reformulatedSolution', '').size() <= 20000)
        && (data.get('expectedResults', '') is string && data.get('expectedResults', '').size() <= 20000)
        && (data.get('audience', '') is string && data.get('audience', '').size() <= 20000)
        && (data.get('strengths', '') is string && data.get('strengths', '').size() <= 20000)
        && (data.get('weaknesses', '') is string && data.get('weaknesses', '').size() <= 20000)
        && (data.get('pilot', '') is string && data.get('pilot', '').size() <= 20000)
        && (data.get('resources', '') is string && data.get('resources', '').size() <= 20000)
        && (data.get('pitch', '') is string && data.get('pitch', '').size() <= 20000)
        && (data.get('pitchStart', '') is string && data.get('pitchStart', '').size() <= 20000)
        && (data.get('pitchProblem', '') is string && data.get('pitchProblem', '').size() <= 20000)
        && (data.get('pitchSolution', '') is string && data.get('pitchSolution', '').size() <= 20000)
        && (data.get('pitchAction', '') is string && data.get('pitchAction', '').size() <= 20000)
        && data.get('isFinished', false) is bool;
    }

    function validTeamStateUpdate(workshopId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let phase = workshop(workshopId).data.currentPhase;
      return validTeamContentShape()
        && request.resource.data.team == resource.data.team
        && request.resource.data.schemaVersion == 2
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastSavedAt == request.time
        && (
          phase == 'Diluir'
            ? changed.hasOnly([
              'perspectives',
              'top3Perspectives',
              'perspectiveVotes',
              'selectedPerspective',
              'lastSavedAt',
              'updatedAt'
            ])
          : phase == 'Conjugar'
            ? changed.hasOnly([
              'solutions',
              'top3Solutions',
              'solutionVotes',
              'selectedSolution',
              'lastSavedAt',
              'updatedAt'
            ])
          : phase == 'Sublimar'
            ? changed.hasOnly([
              'receivedSolutionToAttack',
              'attacksOnOthers',
              'receivedAttacks',
              'defenses',
              'reformulatedSolution',
              'expectedResults',
              'sublimarView',
              'sublimarDefenseCompleted',
              'lastSavedAt',
              'updatedAt'
            ])
            && request.resource.data.get('sublimarView', 'Ataque') in ['Ataque', 'Defensa']
            && validOptionalBool('sublimarDefenseCompleted')
          : phase == 'Fermentar'
            ? changed.hasOnly([
              'audience',
              'strengths',
              'weaknesses',
              'pilot',
              'resources',
              'lastSavedAt',
              'updatedAt'
            ])
          : phase == 'Proyectar'
            ? changed.hasOnly([
              'pitch',
              'pitchStart',
              'pitchProblem',
              'pitchSolution',
              'pitchAction',
              'isFinished',
              'lastSavedAt',
              'updatedAt'
            ])
          : false
        );
    }

    match /organizations/{orgId} {
      allow read: if isOrganizationMember(orgId);
      allow create, update, delete: if false;

      match /members/{userId} {
        allow read: if isOrganizationMember(orgId)
          && (
            request.auth.uid == userId
            || hasOrganizationRole(orgId, ['owner'])
          );
        allow create, update, delete: if false;
      }

      match /invitations/{invitationId} {
        allow read: if hasOrganizationRole(orgId, ['owner']);
        allow create, update, delete: if false;
      }

      match /auditEvents/{eventId} {
        allow read: if hasOrganizationRole(orgId, ['owner']);
        allow create, update, delete: if false;
      }

      match /commandKeys/{commandId} {
        allow read, write: if false;
      }
    }

    match /activeRoomCodes/{roomCode} {
      allow read, write: if false;
    }

    match /joinRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /invitationRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /workshops/{workshopId} {
      allow get: if canManageWorkshopData(resource.data)
        || isWorkshopParticipant(workshopId)
        || isTerminalWorkshopParticipant(workshopId);
      allow list: if canListWorkshopData(resource.data);
      allow create, update, delete: if false;

      match /participantSessions/{participantId} {
        allow read: if isWorkshopAdmin(workshopId)
          || (
            request.auth.uid == participantId
            && isWorkshopParticipant(workshopId)
          );
        allow create, update, delete: if false;
      }

      match /teams/{teamName} {
        allow read: if isWorkshopAdmin(workshopId)
          || (
            isAssignedParticipant(workshopId)
            && participantTeam(workshopId) == teamName
          );
        allow create, delete: if false;
        allow update: if isAssignedParticipant(workshopId)
          && !hasAcknowledgedPendingTransition(workshopId)
          // isAssignedParticipant -> isWorkshopParticipant already requires isActiveWorkshop.
          && validTeam(teamName)
          && participantTeam(workshopId) == teamName
          && validTeamStateUpdate(workshopId);
      }

      match /attacks/{attackId} {
        allow read: if isWorkshopAdmin(workshopId)
          || (
            isAssignedParticipant(workshopId)
            && (
              resource.data.fromTeam == participantTeam(workshopId)
              || resource.data.toTeam == participantTeam(workshopId)
            )
          );
        allow create, update, delete: if false;
      }

      match /defenses/{defenseId} {
        allow read: if isWorkshopAdmin(workshopId)
          || (
            isAssignedParticipant(workshopId)
            && resource.data.team == participantTeam(workshopId)
          );
        allow create, update, delete: if false;
      }

      match /solutions/{teamName} {
        allow read: if isWorkshopAdmin(workshopId)
          || (
            isAssignedParticipant(workshopId)
            && (
              participantTeam(workshopId) == teamName
              || workshop(workshopId).data.currentPhase in [
                'Sublimar',
                'Fermentar',
                'Proyectar'
              ]
            )
          );
        allow create, update: if isAssignedParticipant(workshopId)
          && !hasAcknowledgedPendingTransition(workshopId)
          // The assigned-participant guard above already rejects non-active workshops.
          && isWorkshopPhase(workshopId, 'Conjugar')
          && participantTeam(workshopId) == teamName
          && request.resource.data.team == teamName
          && validText(request.resource.data.content)
          && request.resource.data.timestamp == request.time
          && request.resource.data.schemaVersion == 2
          && request.resource.data.keys().hasOnly([
            'team',
            'content',
            'timestamp',
            'schemaVersion'
          ]);
        allow delete: if false;
      }

      match /reports/{reportId} {
        allow read: if canReadWorkshopReports(workshopId);
        allow create, update, delete: if false;
      }

      match /reportJobs/{jobId} {
        allow read: if canReadWorkshopReports(workshopId);
        allow create, update, delete: if false;
      }

      match /participantDeviceSlots/{slotId} {
        allow read, write: if false;
      }

      match /auditEvents/{eventId} {
        allow read: if canReadWorkshopReports(workshopId);
        allow create, update, delete: if false;
      }

      match /commandKeys/{commandId} {
        allow read, write: if false;
      }
    }

    // Legacy reads also pass through audited server-side platform operations.
    match /games/{gameId} {
      allow read, write: if false;
      match /{legacySubcollection}/{documentId} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
