# Defaults to europe-west1 when omitted. Override per Firebase project when required.
KREATUM_FUNCTIONS_REGION=europe-west1
KREATUM_SCHEDULE_FUNCTIONS_REGION=europe-west1


# Observation mode first. Enable only after staging validation and production telemetry review.
KREATUM_ENFORCE_APP_CHECK=false
# Non-secret access configuration
KREATUM_APP_BASE_URL=https://staging.example.com
KREATUM_ACCESS_EMAIL_FROM=KREATUM | GFS Consulting Group <accesos@gfs.es>
KREATUM_ACCESS_EMAIL_REPLY_TO=administracion@gfs.es
KREATUM_PRIVACY_POLICY_URL=https://staging.example.com/privacidad
KREATUM_PRIVACY_VERSION=2026-08-04
KREATUM_TERMS_URL=https://staging.example.com/terminos
KREATUM_TERMS_VERSION=2026-08-04

# Secrets are configured with Firebase Secret Manager, never in this file:
# firebase functions:secrets:set BREVO_API_KEY --project <staging-id>
# firebase functions:secrets:set INVITATION_CODE_PEPPER --project <staging-id>
# For local emulator integration only, the runner suppresses delivery and uses a fixed code.
